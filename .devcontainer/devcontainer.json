{
  "name": "C# (.NET)",
  // Uses the official .NET devcontainer image — change the version tag as needed
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-9.0",

  // Features to add to the dev container
  "features": {
    "ghcr.io/devcontainers/features/dotnet:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "installTools": true
    }
  },


  "postCreateCommand": "dotnet restore && dotnet tool restore",

  // VS Code extensions to install in the container
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
      ]
    }
  }
}
