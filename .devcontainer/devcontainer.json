{
  "name": "C# (.NET)",
  // Uses the official .NET devcontainer image — change the version tag as needed
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-9.0",


  "postCreateCommand": "dotnet restore && dotnet tool restore",

  // VS Code extensions to install in the container
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit"
      ]
    }
  }
}
